# ============ Phase 1：选题 + 文本 AI ============

# Claude API（启用 AI 选题评估、研究包、理论匹配、脚本生成）
# 没有此 Key 时所有 AI 文本端点会自动回退到本地模板。
ANTHROPIC_API_KEY=
# 默认 Sonnet 4.6；如需更便宜可换 claude-haiku-4-5-20251001。
ANTHROPIC_MODEL=claude-sonnet-4-6

# ============ Phase 3：真实热点抓取（详见 docs/hot-topics.md） ============

# 默认热点抓取 API。公共实例不稳时改成 docker compose up 起的本地实例 http://localhost:8007
HOT_API_BASE=https://api-hot.imsyy.top

# 每个平台用哪个数据源。可选值：daily-hot / xhs-toolkit / trend-radar
# 不配 = daily-hot（小红书/视频号/快手 走代理）
# 推荐生产配置：小红书走 xhs-toolkit（真），视频号走 trend-radar（真），抖音/快手走 daily-hot（真）
XIAOHONGSHU_SOURCE=daily-hot
DOUYIN_SOURCE=daily-hot
SHIPINHAO_SOURCE=daily-hot
KUAISHOU_SOURCE=daily-hot

# 本地 Docker 服务地址（docker compose up -d 后，这些是默认端口）
# 留空 = 该 Provider 不可用，会自动降级到 daily-hot
# 同一个 XHS_TOOLKIT_URL 既用于热点抓取，也用于发布桥接（Phase 2 的 /api/publish/submit）
XHS_TOOLKIT_URL=
XHS_TOOLKIT_TOKEN=
XHS_TOOLKIT_FETCH_PATH=/api/v1/hot
TREND_RADAR_URL=
TREND_RADAR_TOKEN=
TREND_RADAR_FETCH_PATH=/api/trends

# ============ Phase 2：图像 / 配音 / 视频 ============

# 火山引擎 AK/SK（即梦文生图 + 文生视频）
# 申请：https://console.volcengine.com → 视觉智能 → 即梦 AI 开通
# 文档：docs/jimeng.md
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
JIMENG_IMAGE_REQ_KEY=jimeng_t2i_v31
JIMENG_VIDEO_REQ_KEY=jimeng_vgfm_t2v_l20
# 强制走 mock（本地 ffmpeg 占位图）：IMAGE_PROVIDER=mock
IMAGE_PROVIDER=

# 豆包 TTS（appid + access token，与 AK/SK 不同）
# 申请：控制台 → 语音技术 → 语音合成 TTS
BYTEDANCE_TTS_APPID=
BYTEDANCE_TTS_TOKEN=
BYTEDANCE_TTS_CLUSTER=volcano_tts
# 推荐 BV700_streaming（年轻活力女声）；BV701_streaming 沉稳男声
BYTEDANCE_TTS_VOICE=BV700_streaming
# 强制走 mock（静默 mp3）：TTS_PROVIDER=mock
TTS_PROVIDER=

# 视频合成可选：BGM 路径 + 中文字幕字体
# 字体不设时依赖系统 fontconfig（Linux 需 apt install fonts-noto-cjk）
BGM_PATH=
SUBTITLE_FONT=

# ============ Phase 2：多平台发布桥接 ============

# XHS_TOOLKIT_URL 见上方（同一服务），下面只配抖音/视频号/快手的发布桥
# 不配置 = 手动模式（仍记录 publish_logs.json，但不触发自动上传）
SOCIAL_AUTO_UPLOAD_URL=
SOCIAL_AUTO_UPLOAD_TOKEN=
